# Built mods (produced by tools/build.sh). The launcher and Workshop uploads
# point at these; they are regenerated, never hand-edited.
/dist/

# Store copy: the Workshop descriptions (BB Code) and the patch notes that go
# with each release. Written for the store pages, not shipped in any mod, and
# kept out of git so drafts do not clutter the history.
/workshop/
/patch_notes/
