# Built mods (produced by tools/build.sh). The launcher and Workshop uploads
# point at these; they are regenerated, never hand-edited. Release packages from
# tools/package_release.sh land in dist/release.
/dist/

# Publishing copy: the Workshop descriptions and the patch notes for each
# release (tools/tag_release.sh reads them). Written for the store pages, not
# shipped in any mod, and kept out of git so drafts do not clutter the history.
/publishing/
